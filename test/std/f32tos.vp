//! stage: run
//! expect-compile: ok
//! expect-stdout: "0\n-0\ninf\n-inf\nnan\n1\n-1\n0.1\n0.2\n0.3\n3.33333e-1\n3.14159\n2.71828\n123457e5\n1.23457e-10\n-9.99999\n100\n100.5\n1234570\n1.23e-4\n1e-37\n340282e33\n1.17549e-38\n"
//! expect-exit: 0

import std::io as io
import std::conv as conv

pub fn main() : uint32
{
    io::init();
    var num : float32 = undefined;
    var s : usize = undefined;
    let buf : uint8[16];

    num = 0.0;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = -0.0;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = bitcast(float32, 0x7f800000); // inf
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = bitcast(float32, 0xff800000); // -inf
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = bitcast(float32, 0x7fc00000); // nan
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 1.0;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = -1.0;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 0.1;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 0.2;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 0.3;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 0.333333;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 3.14159;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 2.71828;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 1.23457e+10;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 1.23457e-10;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = -9.99999;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 100.0;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 100.5;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 1.23457e+06;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 0.000123;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 1e-37;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 3.40282e+38;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 1.17549e-38;
    s = conv::f32tos(buf, 16, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    return 0;
}