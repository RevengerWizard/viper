//! stage: run
//! expect-compile: ok
//! expect-stdout: "119\n255\n"
//! expect-exit: 0

import std::io as io
import std::conv as conv
from std::conv import ConvError
from std::debug import assert

pub fn main() : uint32
{
    io::init();
    var num : uint8 = 119;
    let buf : uint8[5];

    var s : usize = conv::u8tos(buf, 5, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    num = 255;
    s = conv::u8tos(buf, 5, num);
    io::write(io::stdout, buf, s, nil);
    io::putc('\n');

    return 0;
}