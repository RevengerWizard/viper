pub enum ConvError : uint32
{
    OK,
    INVALID,    // bad characters
    OVERFLOW,   // out of range for target type
    UNDERFLOW,
    EMPTY       // zero-length input
}

inline fn set_err(err : ConvError*?, val : ConvError) : void
{
    if err != nil { *err = val; }
}

pub fn u8tos(buf : uint8*, len : usize, num : uint8) : usize
{
    var digits : usize = 0;
    var tmp : int32 = intcast(int32, num);
    if tmp == 0 { digits = 1; }
    else
    {
        while tmp > 0 { tmp /= 10; digits++; }
    }

    if digits >= len return 0;

    var idx : usize = digits;
    buf[idx] = '\0';

    if num == 0
    {
        buf[0] = '0';
    }
    else
    {
        tmp = intcast(int32, num);
        while tmp > 0
        {
            idx--;
            buf[idx] = intcast(uint8, '0' + intcast(uint8, tmp % 10));
            tmp /= 10;
        }
    }

    return digits;
}

pub fn i8tos(buf : uint8*, len : usize, num : int8) : usize
{
    var neg : bool = num < 0;
    var n : int8 = neg ? -num : num;

    if num == int8::min
    {
        if len < 5 return 0;
        buf[0] = '-';
        buf[1] = '1';
        buf[2] = '2';
        buf[3] = '8';
        buf[4] = '\0';
        return 4;
    }

    var digits : usize = 0;
    var tmp : int8 = n;
    if tmp == 0 { digits = 1; }
    else
    {
        while tmp > 0 { tmp /= 10; digits++; }
    }

    if neg { digits++; }
    if digits >= len return 0;

    var idx : usize = digits;
    buf[idx] = 0;

    if n == 0
    {
        buf[0] = '0';
    }
    else
    {
        tmp = n;
        while tmp > 0
        {
            idx--;
            buf[idx] = intcast(uint8, '0' + intcast(uint8, tmp) % 10);
            tmp /= 10;
        }
    }

    if neg
    {
        idx--;
        buf[idx] = '-';
    }

    return digits;
}

pub fn i32tos(buf : uint8*, len : usize, num : int32) : usize
{
    var neg : bool = num < 0;
    var n : int32 = neg ? -num : num;

    // Special case: INT_MIN cannot be negated
    if num == int32::min
    {
        if len < 12 return 0;
        buf[0] = '-';
        buf[1] = '2';
        buf[2] = '1';
        buf[3] = '4';
        buf[4] = '7';
        buf[5] = '4';
        buf[6] = '8';
        buf[7] = '3';
        buf[8] = '6';
        buf[9] = '4';
        buf[10] = '8';
        buf[11] = 0;
        return 11;
    }

    var digits : usize = 0;
    var tmp : int32 = n;
    if tmp == 0 { digits = 1; }
    else
    {
        while tmp > 0 { tmp /= 10; digits++; }
    }

    if neg { digits++; }
    if digits >= len return 0;

    var idx : usize = digits;
    buf[idx] = 0;

    if n == 0
    {
        buf[0] = '0';
    }
    else
    {
        tmp = n;
        while tmp > 0
        {
            idx--;
            buf[idx] = intcast(uint8, '0' + intcast(uint8, tmp % 10));
            tmp /= 10;
        }
    }

    if neg
    {
        idx--;
        buf[idx] = '-';
    }

    return digits;
}

// grisu3 - fast float-to-string conversion
//
// Based on "Printing Floating-Point Numbers Quickly And Accurately with Integers"
// by Florian Loitsch
//
// Derived from https://github.com/juj/MathGeoLib/blob/master/src/Math/grisu3.c

// Do-it-yourself floating point
struct DiyFp
{
    f : uint64;
    e : int32;
}

// Multiply two DiyFp values: r.f = high 64 bits of x.f * y.f (rounded), r.e = x.e + y.e + 64
inline fn diyfp_multiply(x : DiyFp, y : DiyFp) : DiyFp
{
    // Split each 64-bit mantissa into two 32-bit halves
    let a : uint64 = x.f >> 32;
    let b : uint64 = x.f & 0xFFFFFFFF;
    let c : uint64 = y.f >> 32;
    let d : uint64 = y.f & 0xFFFFFFFF;

    let ac : uint64 = a * c;
    let bc : uint64 = b * c;
    let ad : uint64 = a * d;
    let bd : uint64 = b * d;

    // tmp accumulates the cross terms; add rounding bit
    let tmp : uint64 = (bd >> 32) + (ad & 0xFFFFFFFF) + (bc & 0xFFFFFFFF) + (uint64(1) << 31);

    var r : DiyFp;
    r.f = ac + (ad >> 32) + (bc >> 32) + (tmp >> 32);
    r.e = x.e + y.e + 64;
    return r;
}

inline fn diyfp_minus(x : DiyFp, y : DiyFp) : DiyFp
{
    // assert x.e == y.e && x.f >= y.f
    return DiyFp::{f = x.f - y.f, e = x.e};
}

// Extract a float64 (double) into a DiyFp.
// Uses the IEEE 754 double layout: 1 sign bit, 11 exponent bits, 52 fraction bits.
// D64_EXP_BIAS = 1075 = 1023 + 52 (bias + mantissa width)
fn diyfp_f64(d : float64) : DiyFp
{
    let u64 : uint64 = ptrcast(uint64*, &d)[0];
    let exp_mask  : uint64 = 0x7FF0000000000000;
    let frac_mask : uint64 = 0x000FFFFFFFFFFFFF;
    let implicit1 : uint64 = 0x0010000000000000;

    var fp : DiyFp;
    if (u64 & exp_mask) == 0
    {
        // Denormal: no implicit leading 1
        fp.f = u64 & frac_mask;
        fp.e = 1 - 1075;       // 1 - D64_EXP_BIAS
    }
    else
    {
        // Normal: restore implicit leading 1
        fp.f = (u64 & frac_mask) + implicit1;
        fp.e = intcast(int32, (u64 & exp_mask) >> 52) - 1075;  // biased_exp - D64_EXP_BIAS
    }
    return fp;
}

// Extract a float32 into a DiyFp.
// Uses the IEEE 754 single layout: 1 sign bit, 8 exponent bits, 23 fraction bits.
// F32_EXP_BIAS = 150 = 127 + 23 (bias + mantissa width)
fn diyfp_f32(v : float32) : DiyFp
{
    let bits : uint32 = ptrcast(uint32*, &v)[0];
    let exp_mask  : uint32 = 0x7F800000;
    let frac_mask : uint32 = 0x007FFFFF;
    let implicit1 : uint32 = 0x00800000;

    var fp : DiyFp;
    if (bits & exp_mask) == 0
    {
        // Denormal: no implicit leading 1
        fp.f = intcast(uint64, bits & frac_mask);
        fp.e = 1 - 150;       // 1 - F32_EXP_BIAS
    }
    else
    {
        // Normal: restore implicit leading 1
        fp.f = intcast(uint64, (bits & frac_mask) + implicit1);
        fp.e = intcast(int32, (bits & exp_mask) >> 23) - 150;  // biased_exp - F32_EXP_BIAS
    }
    return fp;
}

// Normalize DiyFp so that the most significant bit of f is 1.
// Uses a fast 10-bit shift when the top 10 bits are all zero, then singles.
fn diyfp_normalize(n : DiyFp) : DiyFp
{
    var f : uint64 = n.f;
    var e : int32  = n.e;

    // Fast path: shift 10 bits at a time while top 10 bits are clear
    while (f & uint64(0xFFC0000000000000)) == 0
    {
        f = f << 10;
        e = e - 10;
    }
    // Fine path: shift 1 bit at a time until bit 63 is set
    while (f & uint64(0x8000000000000000)) == 0
    {
        f = f << 1;
        e = e - 1;
    }
    return DiyFp::{ f = f, e = e };
}

struct Pow10
{
    fract : uint64;
    b_exp, d_exp : int16;
}

